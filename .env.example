# --- optional ---------------------------------------------------------------------------------
# Language model for nicer copilot wording. Default (unset or "none") = deterministic EN/NE templates, no model.
# COPILOT_LLM=ollama          # local: OLLAMA_HOST=http://host.docker.internal:11434  OLLAMA_MODEL=llama3.1:8b
# COPILOT_LLM=openai          # OPENAI_API_KEY=...  OPENAI_MODEL=gpt-4o-mini
# HF_TOKEN=...                # only if the Kuro Siwo download asks for a Hugging Face token
# Which results the API/dashboard read (default data/outputs). A real run writes to data/runs/<AOI>_<date>/outputs:
# FLOOD_OUT=data/runs/Trishuli_2026_2026-08-26/outputs
# AUTO_DEMO=0                 # do not fill an empty FLOOD_OUT with the synthetic demo
